# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# FLUTTERWAVE_SECRET_KEY: Optional live/sandbox secret key for Flutterwave v3 split payments & M-Pesa transfers.
# When omitted, KaziGrid runs an interactive server-side sandbox protocol simulator.
FLUTTERWAVE_SECRET_KEY=""

# FLUTTERWAVE_PUBLIC_KEY: Optional public key for Flutterwave inline checkout.
FLUTTERWAVE_PUBLIC_KEY=""

# FLUTTERWAVE_WEBHOOK_HASH: Optional webhook verification hash for /api/webhooks/flutterwave.
FLUTTERWAVE_WEBHOOK_HASH=""
